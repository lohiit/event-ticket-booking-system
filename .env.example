DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=event_ticket_booking
DB_USER=event_app
DB_PASS=replace-with-your-local-password
# Use local/test with rzp_test_ keys. Production requires APP_ENV=production and rzp_live_ keys.
APP_ENV=local
RAZORPAY_KEY_ID=rzp_test_replace_with_key_id
RAZORPAY_KEY_SECRET=replace-with-test-key-secret
SESSION_DRIVER=file
EVENT_IMAGE_UPLOADS=enabled
